{
    "name": "survos/mapillary-bundle",
    "description": "Thin Symfony integration for the survos/mapillary API client.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "survos/kit-bundle": "^2.41",
        "survos/mapillary": "^0.1 || dev-main",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/validator": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "symfony/framework-bundle": "^8.1"
    },
    "autoload": {"psr-4": {"Survos\\MapillaryBundle\\": "src/"}},
    "autoload-dev": {"psr-4": {"Survos\\MapillaryBundle\\Tests\\": "tests/"}}
}
